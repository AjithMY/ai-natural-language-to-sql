# Database Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=minor_project
DB_USER=root
DB_PASSWORD=your_password_here

# ---------------------------------------------------------------------------
# Phase 2: CORS, environment, debug
# ---------------------------------------------------------------------------

# Allowed frontend origins (comma-separated).
# These defaults are for local development only.
# Update before deploying to production with your actual frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Deployment environment: 'development' or 'production'
ENVIRONMENT=development

# Set to True to enable DEBUG-level log output (verbose — use in dev only)
APP_DEBUG=False

# ---------------------------------------------------------------------------
# Phase 3: Gemini AI Configuration
# ---------------------------------------------------------------------------

# Your Google Gemini API key — get it from https://aistudio.google.com/app/apikey
# NEVER commit the real key to version control.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for SQL generation.
GEMINI_MODEL=gemini-flash-lite-latest

